# Auth
# Generate with: node scripts/generate-passcode-hash.mjs "your-passcode"
YAN_STUDY_PASSCODE_HASH=
# Dev fallback only (avoid in production)
YAN_STUDY_PASSCODE=
SESSION_SECRET=

# Client data mode: local | api
NEXT_PUBLIC_DATA_MODE=api

# Server data backend: local | dynamodb
DATA_BACKEND=local

# DynamoDB table names (required when DATA_BACKEND=dynamodb)
YAN_STUDY_SESSIONS_TABLE=
YAN_STUDY_TODOS_TABLE=
YAN_STUDY_SETTINGS_TABLE=
AWS_REGION=eu-central-1

# Optional: bearer token for automatic CSV health ingestion endpoints
# Routes: POST /api/integrations/health/csv, POST /api/integrations/health/import-batch
HEALTH_EXPORT_BEARER_TOKEN=

# Optional: bearer token for future iOS native health sync endpoint
MOBILE_HEALTH_SYNC_BEARER_TOKEN=
