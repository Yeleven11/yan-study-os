# Auth
# Generate with: npm run passcode:hash -- "your-passcode"
YAN_STUDY_PASSCODE_HASH=
# Dev fallback only (avoid in production)
YAN_STUDY_PASSCODE=
SESSION_SECRET=

# Client data mode: local | api
NEXT_PUBLIC_DATA_MODE=api

# Server data backend: local | neon | dynamodb
# local writes to runtime-data/yan-study-os.json (not durable on serverless hosting)
DATA_BACKEND=local

# Neon backend connection (required when DATA_BACKEND=neon)
# Vercel Storage integration usually provides STORAGE_URL automatically; this value can mirror it.
NEON_DATABASE_URL=
# Optional: custom table name for persisted JSON state
NEON_STATE_TABLE=yan_study_state

# DynamoDB table names (required when DATA_BACKEND=dynamodb)
YAN_STUDY_SESSIONS_TABLE=
YAN_STUDY_TODOS_TABLE=
YAN_STUDY_SETTINGS_TABLE=

# Region resolution order in code: DYNAMO_REGION -> AWS_REGION -> AWS_DEFAULT_REGION -> eu-central-1
DYNAMO_REGION=
AWS_REGION=eu-central-1
AWS_DEFAULT_REGION=

# Optional: bearer token for CSV and batch health ingestion endpoints
# Routes:
# - POST /api/integrations/health/csv
# - POST /api/integrations/health/import-batch
HEALTH_EXPORT_BEARER_TOKEN=

# Optional: dedicated bearer token for native iOS JSON sync endpoint
# Route: POST /api/integrations/health/mobile-sync
MOBILE_HEALTH_SYNC_BEARER_TOKEN=

# Optional: default base URL used by scripts/import-health-folder.mjs
HEALTH_IMPORT_BASE_URL=http://localhost:3000
