// Shared build-time sync configuration.
// Optional local overrides live in Env.local.xcconfig (not committed).

#include? "Env.local.xcconfig"

SYNC_BASE_URL = https://www.ibdp.study
SYNC_BEARER_TOKEN =
SYNC_ENDPOINT_PATH = /api/integrations/health/mobile-sync
SYNC_REQUEST_TIMEOUT_SECONDS = 30
SYNC_BATCH_SIZE = 500
SYNC_DEFAULT_INTERVAL_MIN = 30
SYNC_MIN_INTERVAL_MIN = 15
SYNC_MAX_INTERVAL_MIN = 180
