// Copy this file to your iOS app folder as Config/Env.local.xcconfig
// Example:
// /Users/yanborovyk/Desktop/Code Projects/IbWebsite/ios/StudyHealthSync/Config/Env.local.xcconfig

SYNC_BASE_URL = https://your-domain.com
SYNC_BEARER_TOKEN = your-long-random-token

// Optional overrides (defaults are defined in Env.shared.xcconfig)
SYNC_ENDPOINT_PATH = /api/integrations/health/mobile-sync
SYNC_REQUEST_TIMEOUT_SECONDS = 30
SYNC_DEFAULT_INTERVAL_MIN = 30
SYNC_MIN_INTERVAL_MIN = 15
SYNC_MAX_INTERVAL_MIN = 180
SYNC_BATCH_SIZE = 500
